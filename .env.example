# Aster DEX (Pro API agent wallet: https://www.asterdex.com/en/api-wallet)
ASTER_API_KEY=0x...          # Agent wallet address (signer)
ASTER_API_SECRET=0x...       # Agent wallet private key
ASTER_WALLET_ADDRESS=0x...   # Main account wallet

# Spot leg venue: kucoin (default since Nov 2026) or mexc
# SPOT_VENUE=kucoin
# KuCoin (API key with General + Spot Trading permission; restrict it to this server's IP)
KUCOIN_API_KEY=...
KUCOIN_API_SECRET=...
KUCOIN_API_PASSPHRASE=...      # the passphrase you chose when creating the key
# KUCOIN_API_KEY_VERSION=2     # 2 for current keys; 3 if KuCoin shows the key as version 3
# KUCOIN_HF=                   # leave unset: classic vs high-frequency account is detected
# SPOT_TAKER_FEE=0.001         # override the spot fees if your tier differs (0.0008 paying fees in KCS)
# SPOT_MAKER_FEE=0.001

# MEXC (only if SPOT_VENUE=mexc)
# MEXC_API_KEY=mx0v...
# MEXC_API_SECRET=...

# Telegram
ALERT_TELEGRAM_BOT_TOKEN=...
ALERT_TELEGRAM_CHAT_ID=...
CONTROL_TELEGRAM_CHAT_IDS=...   # comma-separated allowlist

# Optional
# ALERT_DISCORD_WEBHOOK_URL=...

# AI advisor (advisory only — /review and the 4h timer). Without this the
# advisor replies that it is not configured; nothing else is affected.
# ANTHROPIC_API_KEY=sk-ant-...
# ADVISOR_MODEL=claude-opus-4-8     # default; any Messages-API model id works
