# Aster DEX (Pro API agent wallet: https://www.asterdex.com/en/api-wallet)
ASTER_API_KEY=0x...          # Agent wallet address (signer)
ASTER_API_SECRET=0x...       # Agent wallet private key
ASTER_WALLET_ADDRESS=0x...   # Main account wallet

# MEXC (spot trading permission required)
MEXC_API_KEY=mx0v...
MEXC_API_SECRET=...

# Telegram
ALERT_TELEGRAM_BOT_TOKEN=...
ALERT_TELEGRAM_CHAT_ID=...
CONTROL_TELEGRAM_CHAT_IDS=...   # comma-separated allowlist

# Optional
# ALERT_DISCORD_WEBHOOK_URL=...

# AI advisor (advisory only — /review and the 4h timer). Without this the
# advisor replies that it is not configured; nothing else is affected.
# ANTHROPIC_API_KEY=sk-ant-...
# ADVISOR_MODEL=claude-opus-4-8     # default; any Messages-API model id works
