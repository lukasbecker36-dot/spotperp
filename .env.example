# Aster DEX (Pro API agent wallet: https://www.asterdex.com/en/api-wallet)
ASTER_API_KEY=0x...          # Agent wallet address (signer)
ASTER_API_SECRET=0x...       # Agent wallet private key
ASTER_WALLET_ADDRESS=0x...   # Main account wallet

# MEXC (spot trading permission required)
MEXC_API_KEY=mx0v...
MEXC_API_SECRET=...

# Telegram
ALERT_TELEGRAM_BOT_TOKEN=...
ALERT_TELEGRAM_CHAT_ID=...
CONTROL_TELEGRAM_CHAT_IDS=...   # comma-separated allowlist

# Optional
# ALERT_DISCORD_WEBHOOK_URL=...
