[Unit]
Description=Run the AI advisor review every 4 hours

[Timer]
# Every 4 hours on the clock (00:00, 04:00, ... UTC). Persistent catches up a
# missed run after downtime; RandomizedDelay avoids hitting the API on the dot.
OnCalendar=*-*-* 00/4:00:00 UTC
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
