[Unit]
Description=Wake the AI advisor hourly; it self-gates to the UK run schedule

[Timer]
# Wake every hour at :30. advisor.py itself decides whether to run, firing only
# when the ADVISOR_TIMEZONE hour is a configured run hour (default UK 07:30,
# 11:30, 15:30, 19:30, 23:30 — nothing overnight). Gating in Python keeps this
# working on any systemd version and whatever the box's clock is set to, and it
# follows DST via the tz database. Persistent catches up a run missed to
# downtime.
OnCalendar=*-*-* *:30:00
Persistent=true

[Install]
WantedBy=timers.target
